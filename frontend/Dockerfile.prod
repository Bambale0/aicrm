# Production Dockerfile для React frontend
FROM node:20-alpine as builder

RUN apk add --no-cache git

WORKDIR /app

ARG REACT_APP_ENABLE_REGISTRATION=false
ENV REACT_APP_ENABLE_REGISTRATION=$REACT_APP_ENABLE_REGISTRATION
ARG REACT_APP_AUTH_REQUIRED=true
ENV REACT_APP_AUTH_REQUIRED=$REACT_APP_AUTH_REQUIRED
ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=$REACT_APP_API_URL

COPY package*.json ./

RUN npm install --legacy-peer-deps

COPY . .

RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/build /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    location ~* \.(png|jpg|jpeg|gif|svg|ico|webp|css|js|map|woff|woff2)$ {' \
    '        try_files $uri =404;' \
    '    }' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
