# Runtime
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REQUIRED=true
PUBLIC_REGISTRATION_ENABLED=false

# Database / Redis
POSTGRES_DB=aicrm
POSTGRES_USER=aicrm_user
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=aicrm_postgres_data
REDIS_VOLUME_NAME=aicrm_redis_data
DATABASE_URL=postgresql+psycopg2://aicrm_user:replace-with-a-random-password@postgres:5432/aicrm
REDIS_URL=redis://redis:6379/0

# Local bind settings
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_PORT=9001
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_PORT=9000

# Browser API base. Same-origin deployment uses /api.
FRONTEND_API_URL=/api

# Optional comma-separated cross-origin browser origins.
CORS_ORIGINS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
AI_API_BASE_URL=https://your-ai-provider.example/v1
AI_API_TIMEOUT_SECONDS=30
AUTOMATION_MAX_DEPTH=8
